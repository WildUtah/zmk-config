// See https://zmk.dev/docs/development/hardware-integration/physical-layouts
// for how to configure this.

#include <physical_layouts.dtsi>

/ {
    default_layout: default_layout {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>;
        kscan = <&kscan>;

        // https://zmk.dev/docs/development/hardware-integration/physical-layouts#optional-keys-property
        keys  //                   w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 90 90  100   30       0     0     0>
            , <&key_physical_attrs 90 90  200    0       0     0     0>
            , <&key_physical_attrs 90 90  300   40       0     0     0>

            , <&key_physical_attrs 90 90 1100   40       0     0     0>
            , <&key_physical_attrs 90 90 1200    0       0     0     0>
            , <&key_physical_attrs 90 90 1300   30       0     0     0>


            , <&key_physical_attrs 90 90    0  250       0     0     0>
            , <&key_physical_attrs 90 90  100  130       0     0     0>
            , <&key_physical_attrs 90 90  200  100       0     0     0>
            , <&key_physical_attrs 90 90  300  140       0     0     0>
            , <&key_physical_attrs 90 90  400  150       0     0     0>

            , <&key_physical_attrs 90 90 1000  150       0     0     0>
            , <&key_physical_attrs 90 90 1100  140       0     0     0>
            , <&key_physical_attrs 90 90 1200  100       0     0     0>
            , <&key_physical_attrs 90 90 1300  130       0     0     0>
            , <&key_physical_attrs 90 90 1400  250       0     0     0>


            , <&key_physical_attrs 90 90  100  230       0     0     0>
            , <&key_physical_attrs 90 90  200  200       0     0     0>
            , <&key_physical_attrs 90 90  300  240       0     0     0>

            , <&key_physical_attrs 90 90 1100  240       0     0     0>
            , <&key_physical_attrs 90 90 1200  200       0     0     0>
            , <&key_physical_attrs 90 90 1300  230       0     0     0>

            , <&key_physical_attrs 90 90  300  400       4500     45     0>
            , <&key_physical_attrs 90 90  420  400       0     0     0>
            , <&key_physical_attrs 90 90  980  400       0     0     0>
            , <&key_physical_attrs 90 90 1100  400       4500     45     0>
            ;
    };
};
