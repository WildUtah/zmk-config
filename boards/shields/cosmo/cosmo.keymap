#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    
    macros {
      qu:qu {
             compatible = "zmk,behavior-macro";
             #binding-cells = <0>;
             bindings
                 = <&macro_tap &kp Q &kp U>
                 ;
         };
      capqu:capqu {
             compatible = "zmk,behavior-macro";
             #binding-cells = <0>;
             bindings
                 = <&macro_press &kp RSHIFT>
                 , <&macro_tap &kp Q >
                 , <&macro_release &kp RSHIFT>
                 , <&macro_tap &kp U>
                 ;
         };
      the:the {
             compatible = "zmk,behavior-macro";
             #binding-cells = <0>;
             bindings
                 = <&macro_tap &kp T &kp H &kp E>
                 ;
         };

    };

    behaviors {
      lt: layer_tap {
            flavor = "balanced";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <90>;
            retro-tap;
          };
      mt: mod_tap {
        quick-tap-ms = <450>;
          };

      updownu:updownu {
               compatible = "zmk,behavior-mod-morph";
               #binding-cells = <0>;
               bindings = <&qutest>, <&capqu>;
               mods = <(MOD_LSFT)>;
            };
      qutest:qutest {
               compatible = "zmk,behavior-mod-morph";
               #binding-cells = <0>;
               bindings = <&qu>, <&kp Q>;
               mods = <(MOD_LALT|MOD_RALT)>;
            };

      dashes: en_em_dash {
               compatible = "zmk,behavior-mod-morph";
               #binding-cells = <0>;
               bindings = <&kp MINUS>, <&kp RS(RA(MINUS))>;
               mods = <(MOD_LSFT|MOD_RSFT)>;
           };
      permilcent: cent_mil {
               compatible = "zmk,behavior-mod-morph";
               #binding-cells = <0>;
               bindings = <&kp PERCENT>, <&kp RS(RA(R))>;
               mods = <(MOD_LSFT|MOD_RSFT)>;
           };
      zero_degrees: zero_but_degree {
               compatible = "zmk,behavior-mod-morph";
               #binding-cells = <0>;
               bindings = <&kp KP_N0>, <&kp RA(N0)>;
               mods = <(MOD_LSFT|MOD_RSFT)>;
           };
      separators: dot_or_comma {
               compatible = "zmk,behavior-mod-morph";
               #binding-cells = <0>;
               bindings = <&aux_separators >, <&kp COMMA>;
               mods = <(MOD_LSFT|MOD_RSFT)>;
           };
      aux_separators: normal_or_C {
               compatible = "zmk,behavior-mod-morph";
               #binding-cells = <0>;
               bindings = <&kp DOT >, <&kp SQT>;
               mods = <(MOD_LALT|MOD_RALT)>;
           };
      starmul: threemuls {
               compatible = "zmk,behavior-mod-morph";
               #binding-cells = <0>;
               bindings = <&xmul>, <&kp RA(N8)>;
               mods = <(MOD_LSFT|MOD_RSFT)>;
           };
      xmul: threemuls_aux {
               compatible = "zmk,behavior-mod-morph";
               #binding-cells = <0>;
               bindings = <&kp STAR>, <&kp RC(RS(RA(X)))>;
               mods = <(MOD_LALT|MOD_RALT)>;
           };
      infinity_rp: infinity_rp {
               compatible = "zmk,behavior-mod-morph";
               #binding-cells = <0>;
               bindings = <&kp RPAR>, <&kp RA(N5)>;
               mods = <(MOD_LSFT|MOD_RSFT)>;
           };
      gt_gtq: gt_gtq {
               compatible = "zmk,behavior-mod-morph";
               #binding-cells = <0>;
               bindings = <&kp GT>, <&kp RS(RA(BSLH))>;
               mods = <(MOD_LSFT|MOD_RSFT)>;
           };
      lt_ltq: lt_ltq {
               compatible = "zmk,behavior-mod-morph";
               #binding-cells = <0>;
               bindings = <&kp LT>, <&kp RA(BSLH)>;
               mods = <(MOD_LSFT|MOD_RSFT)>;
           };
      and_section: and_section {
               compatible = "zmk,behavior-mod-morph";
               #binding-cells = <0>;
               bindings = <&kp AMPS>, <&kp RA(N6)>;
               mods = <(MOD_LSFT|MOD_RSFT)>;
           };
      twodivides: twodivides {
               compatible = "zmk,behavior-mod-morph";
               #binding-cells = <0>;
               bindings = <&kp SLASH>, <&kp RA(SLASH)>;
               mods = <(MOD_LSFT|MOD_RSFT)>;
           };
      almostequal: almostequal {
               compatible = "zmk,behavior-mod-morph";
               #binding-cells = <0>;
               bindings = <&kp EQUAL>, <&kp RA(X)>;
               mods = <(MOD_LSFT|MOD_RSFT)>;
           };
      quotebacktick: quotebacktick {
               compatible = "zmk,behavior-mod-morph";
               #binding-cells = <0>;
               bindings = <&kp SQT>, <&kp GRAVE>;
               mods = <(MOD_LSFT|MOD_RSFT)>;
           };
      plusminus: plusminus {
               compatible = "zmk,behavior-mod-morph";
               #binding-cells = <0>;
               bindings = <&kp PLUS>, <&kp RS(RA(EQUAL))>;
               mods = <(MOD_LSFT|MOD_RSFT)>;
           };
      exclinv: exclinv {
               compatible = "zmk,behavior-mod-morph";
               #binding-cells = <0>;
               bindings = <&kp  EXCL>, <&kp RA(N1)>;
               mods = <(MOD_LSFT|MOD_RSFT)>;
           };
      questioninv: questioninv {
               compatible = "zmk,behavior-mod-morph";
               #binding-cells = <0>;
               bindings = <&kp QUESTION>, <&kp RS(RA(SLASH))>;
               mods = <(MOD_LSFT|MOD_RSFT)>;
           };
      commatwiddle: commatwiddle {
               compatible = "zmk,behavior-mod-morph";
               #binding-cells = <0>;
               bindings = <&kp COMMA>, <&kp TILDE>;
               mods = <(MOD_LSFT|MOD_RSFT)>;
           };
      dotupper: dotupper {
               compatible = "zmk,behavior-mod-morph";
               #binding-cells = <0>;
               bindings = <&kp DOT>, <&kp CARET>;
               mods = <(MOD_LSFT|MOD_RSFT)>;
           };
    };

    combos { 
        compatible = "zmk,combos";
        //
        // home row TODO: timing adjustments, homerow mods?
        //
        combo_l_paren {
            key-positions = <7 8>;
            bindings = <&kp LPAR>;
            layers = <0>;
        };
        combo_r_paren {
            key-positions = <13 14>;
            bindings = <&infinity_rp>;
            layers = <0>;
        };
        combo_tab {
            key-positions = <7 8 9>;
            bindings = <&kp TAB>;
            layers = <0>;
        };
        combo_c {
            key-positions = <8 9>;
            bindings = <&plusminus>;
            require-prior-idle-ms = <55>;
            timeout-ms = <33>;
            layers = <0>;
        };
        combo_d {
            key-positions = <7 14>;
            bindings = <&quotebacktick>;
            layers = <0>;
        };
        combo_equal {
            key-positions = <8 13>;
            bindings = <&almostequal>;
            layers = <0>;
        };
        combo_f {
            key-positions = <9 12>;
            bindings = <&kp DQT>;
            layers = <0>;
        };
        combo_r_bracket {
            key-positions = <12 15>;
            bindings = <&kp RBKT>;
            require-prior-idle-ms = <50>;
            timeout-ms = <33>;
            layers = <0>;
        };
        combo_l_bracket {
            key-positions = <6 9>;
            bindings = <&kp LBKT>;
            layers = <0>;
        };
        combo_l_brace {
            key-positions = <7 9>;
            bindings = <&kp LBRC>;
            layers = <0>;
        };
        combo_r_brace {
            key-positions = <12 14>;
            bindings = <&kp RBRC>;
            require-prior-idle-ms = <70>;
            timeout-ms = <30>;
            layers = <0>;
        };
        combo_dash {
            key-positions = <12 13>;
            bindings = <&dashes>;
            require-prior-idle-ms = <50>;
            timeout-ms = <35>;
            layers = <0>;
        };
        combo_hash {
            key-positions = <7 13>;
            bindings = <&kp HASH>;
            layers = <0>;
        };
        combo_percent_mil {
            key-positions = <8 14>;
            bindings = <&permilcent>;
            layers = <0>;
        };
        combo_backslash {
            key-positions = <6 15>;
            bindings = <&kp BSLH>;
            layers = <0>;
        };


        combo_question {
            key-positions = <20 21>;
            bindings = <&questioninv>;
            layers = <0>;
        };
        combo_underscore {
            key-positions = <18 19>;
            bindings = <&kp UNDERSCORE>;
            layers = <0>;
        };
        combo_r {
            key-positions = <0 1>;
            bindings = <&lt_ltq>;
            layers = <0>;
        };
        combo_s {
            key-positions = <4 5>;
            bindings = <&gt_gtq>;
            layers = <0>;
        };
        combo_colon {
            key-positions = <17 18>;
            bindings = <&kp COLON>;
            layers = <0>;
        };
        combo_semicolon {
            key-positions = <19 20>;
            bindings = <&kp SEMI>;
            layers = <0>;
        };
        combo_ampersand {
            key-positions = <1 4>;
            bindings = <&and_section>;
            layers = <0>;
        };
        combo_pipe {
            key-positions = <0 5>;
            bindings = <&kp PIPE>;
            layers = <0>;
        };
        combo_exclam {
            key-positions = <1 5>;
            bindings = <&exclinv>;
            layers = <0>;
        };
        combo_multiply {
            key-positions = <0 4>;
            bindings = <&starmul>;
            layers = <0>;
        };
        combo_at {
            key-positions = <16 21>;
            bindings = <&kp AT>;
            layers = <0>;
        };
        combo_slash {
            key-positions = <17 20>;
            bindings = <&twodivides>;
            layers = <0>;
        };
        combo_topslash {
            key-positions = <2 3>;
            bindings = <&twodivides>;
            layers = <0>;
        };
        combo_dollar {
            key-positions = <16 17>;
            bindings = <&kp DOLLAR>;
            layers = <0>;
        };

        //
        //bluetooth and firmware controls
        //
        combo_btsel {
            key-positions = <7 8 9 10>;
            bindings = <&bt BT_NXT>;
            layers = <0>;
        };
        combo_btzero {
            key-positions = <6 7 8 9>;
            bindings = <&bt BT_SEL 0>;
            layers = <0>;
        };
        combo_btclr {
            key-positions = <6 7 8 9 10>;
            bindings = <&bt BT_CLR>;
            layers = <0>;
        };
        combo_firmware_reload {
            key-positions = <0 1 2 16 17 18 >;
            bindings = <&bootloader>;
            layers = <0>;
        };
        combo_firmware_reload_right {
            key-positions = <3 4 5 19 20 21>;
            bindings = <&bootloader>;
            layers = <0>;
        };

        //studio
        combo_studio {
            key-positions = <0 7 16>;
            bindings = <&studio_unlock>;
            layers = <0>;
        };

        //
        // rare letters on combos
        //
        combo_qu {
            key-positions = <3 5>;
            bindings = <&updownu>;
            layers = <0>;
        };
        combo_j {
            key-positions = <0 2>;
            bindings = <&kp J>;
            layers = <0>;
        };
        //combo_zz {
        //    key-positions = <9 19>;
        //    bindings = <&kp Z>;
        //    layers = <0>;
        //};
        //combo_xx {
        //    key-positions = <12 18>;
        //    bindings = <&kp X>;
        //    layers = <0>;
        //};
        combo_x {
            key-positions = <3 4>;
            bindings = <&kp X>;
            timeout-ms = <77>;
            layers = <0>;
        };
        combo_z {
            key-positions = <1 2>;
            bindings = <&kp Z>;
            timeout-ms = <77>;
            layers = <0>;
        };
        combo_k {
            key-positions = <19 21>;
            bindings = <&kp K>;
            timeout-ms = <66>;
            layers = <0>;
        };
        combo_v {
            key-positions = <16 18>;
            bindings = <&kp V>;
            timeout-ms = <77>;
            layers = <0>;
        };
        
        //funny game
        combo_the {
            key-positions = <9 10>;
            bindings = <&the>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "base";
            bindings = <
                &kp W &kp F &kp P   &kp L &kp U &kp Y
                &lt 1 A  &kp R &kp S &kp T &kp G &kp M &kp N &kp E &kp I &kp O
                &kp B &kp C &kp D &kp H &commatwiddle &dotupper 
                &mt LALT ESC &mt LSHIFT BSPC &mt LCTRL SPACE &mt LGUI RET
            >;
        };
        numpad_layer {
            display-name = "numpad";
            bindings = <
                &kp HOME &kp UP &kp END   &kp KP_N7 &kp KP_N8 &kp KP_N9
                &trans  &kp LEFT &kp DOWN &kp RIGHT &kp LG(LC(LS(N4))) &separators &kp KP_N4 &kp KP_N5 &kp KP_N6 &zero_degrees
                &kp RG(RC(SPACE)) &kp K_APP &kp LG(SPACE) &kp KP_N1 &kp KP_N2 &kp KP_N3
                &trans &trans &trans &trans
            >;
        };
    };
};
